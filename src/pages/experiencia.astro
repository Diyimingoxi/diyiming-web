---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseCard from "../components/CaseCard.astro";
import { getCases, type CaseStudy } from "../lib/sanity";

const cmsCases = await getCases();
const fallback: CaseStudy[] = [
  { sector: "Infraestructura educativa", title: "Espacios que amplían oportunidades de aprendizaje.", summary: "Evaluación y articulación de iniciativas para mejorar condiciones educativas." },
  { sector: "Salud y bienestar", title: "Servicios más cercanos para las comunidades.", summary: "Apoyo en proyectos que fortalecen capacidad y acceso a atención." },
  { sector: "Movilidad y conectividad", title: "Infraestructura que integra territorios.", summary: "Rutas para impulsar conectividad, productividad y acceso a servicios." },
  { sector: "Agua y saneamiento", title: "Servicios esenciales para una vida digna.", summary: "Proyectos orientados a mejorar cobertura, continuidad y calidad." },
  { sector: "Seguridad ciudadana", title: "Entornos mejor preparados para proteger.", summary: "Iniciativas de infraestructura y equipamiento con enfoque preventivo." },
  { sector: "Espacio público", title: "Ciudades que favorecen convivencia y desarrollo.", summary: "Proyectos de recuperación y mejora de entornos de uso comunitario." }
];
const cases = cmsCases.length ? cmsCases : fallback;
---

<BaseLayout title="Experiencia | Diyiming Consultores" description="Ámbitos de experiencia y capacidades de Diyiming Consultores en proyectos de Obras por Impuestos.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Inicio</a> / Experiencia</div><span class="eyebrow">Ámbitos de impacto</span><h1>Experiencia orientada a resolver desafíos concretos.</h1><p class="lead">Presentamos los sectores en los que una gestión OxI bien estructurada puede contribuir a cerrar brechas y fortalecer servicios públicos.</p></div></section>
  <section class="section"><div class="container"><div class="notice"><strong>Transparencia primero.</strong> Los nombres, montos y resultados de proyectos se incorporarán únicamente cuando cuenten con validación y autorización del cliente. No publicamos cifras no confirmadas.</div><div class="case-grid" style="margin-top:35px">{cases.map(item => <CaseCard item={item} />)}</div></div></section>
</BaseLayout>
