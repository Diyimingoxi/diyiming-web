---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSettings } from "../lib/sanity";

const settings = await getSettings();
const email = "info@diyiming.pe";
const address = settings.address || "Calle Luis Medina 176, San Miguel, Ica";
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<BaseLayout title="Contacto | Diyiming Consultores" description="Converse con Diyiming Consultores sobre una oportunidad o proyecto mediante Obras por Impuestos.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Inicio</a> / Contacto</div>
      <span class="eyebrow">Conversemos</span>
      <h1>Hablemos sobre tu próximo proyecto.</h1>
      <p class="lead">Cuéntanos qué necesitas y nuestro equipo te ayudará a encontrar una solución eficiente y adecuada para tu operación.</p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">Contacto</span>
        <h2>Hablemos de tu próximo proyecto.</h2>
        <p class="lead">Déjanos tus datos y nuestro equipo se pondrá en contacto contigo para brindarte una orientación inicial.</p>
        <div class="contact-list">
          <div class="contact-item"><b>Correo</b><br /><a href={`mailto:${email}`}>{email}</a></div>
          {settings.phone && <div class="contact-item"><b>Teléfono</b><br /><a href={`tel:${settings.phone.replace(/\s/g, "")}`}>{settings.phone}</a></div>}
          <div class="contact-item"><b>Ubicación</b><br />{address}</div>
          <div class="contact-item"><b>Atención</b><br />{settings.contactHours || "Reuniones presenciales y virtuales previa coordinación."}</div>
        </div>
      </div>
      <form class="form lead-form" id="contact-form">
        <div class="form-heading">
          <span>Consulta inicial</span>
          <h3>Cuéntenos sobre su necesidad</h3>
          <p>Campos marcados con * son obligatorios.</p>
        </div>
        <div class="form-row">
          <label>Nombre y apellido *<input required name="name" autocomplete="name" maxlength="120" /></label>
          <label>Empresa o entidad<input name="company" autocomplete="organization" maxlength="160" /></label>
        </div>
        <div class="form-row">
          <label>Correo electrónico *<input required type="email" name="email" autocomplete="email" maxlength="180" /></label>
          <label>Teléfono<input type="tel" name="phone" autocomplete="tel" maxlength="40" /></label>
        </div>
        <label>Motivo de consulta
          <select name="interest">
            <option>Evaluar una oportunidad OxI</option>
            <option>Asesoría para empresa privada</option>
            <option>Asesoría para entidad pública</option>
            <option>Comercialización de CIPRL</option>
            <option>Capacitación especializada</option>
            <option>Deseo un perfil o ficha técnica</option>
            <option>Otra consulta</option>
          </select>
        </label>
        <label>Cuéntenos brevemente *<textarea required name="message" maxlength="2500"></textarea></label>
        <label class="consent"><input required type="checkbox" name="consent" /> <span>Acepto que Diyiming utilice estos datos para responder y dar seguimiento a mi consulta, de acuerdo con la <a href="/privacidad">política de privacidad</a>.</span></label>
        <label class="hp-field" aria-hidden="true">Sitio web<input name="website" tabindex="-1" autocomplete="off" /></label>
        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
        <button class="btn btn-primary submit-button" type="submit">Enviar consulta</button>
        <div class="form-status" id="form-status" role="status" aria-live="polite"></div>
        <p class="legal">No solicitamos archivos adjuntos ni datos sensibles. La consulta quedará en el registro privado de Diyiming.</p>
      </form>
    </div>
  </section>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const status = document.querySelector<HTMLElement>("#form-status");
    const button = form?.querySelector<HTMLButtonElement>(".submit-button");
    const reasons: Record<string, string> = {
      "gestion-oxi": "Evaluar una oportunidad OxI",
      "comercializacion-ciprl": "Comercialización de CIPRL",
      "capacitacion": "Capacitación especializada",
      "perfil-ficha-tecnica": "Deseo un perfil o ficha técnica"
    };
    const requestedReason = new URLSearchParams(window.location.search).get("motivo");
    const interest = form?.querySelector<HTMLSelectElement>('select[name="interest"]');
    if (requestedReason && interest && reasons[requestedReason]) interest.value = reasons[requestedReason];
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form || !status || !button) return;
      button.disabled = true;
      button.textContent = "Enviando...";
      status.className = "form-status";
      status.textContent = "";
      const data = new FormData(form);
      const payload = {
        name: data.get("name"), company: data.get("company"), email: data.get("email"),
        phone: data.get("phone"), interest: data.get("interest"), message: data.get("message"),
        consent: data.get("consent") === "on", website: data.get("website"),
        turnstileToken: data.get("cf-turnstile-response"), page: window.location.href,
      };
      try {
        const response = await fetch("/api/leads", {
          method: "POST", headers: {"content-type": "application/json"}, body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || "No se pudo enviar la consulta.");
        status.className = "form-status success";
        status.textContent = result.message;
        form.reset();
        const turnstile = (window as Window & {turnstile?: {reset: () => void}}).turnstile;
        turnstile?.reset();
      } catch (error) {
        status.className = "form-status error";
        status.textContent = error instanceof Error ? error.message : "No se pudo enviar la consulta.";
      } finally {
        button.disabled = false;
        button.textContent = "Enviar consulta";
      }
    });
  </script>
</BaseLayout>
