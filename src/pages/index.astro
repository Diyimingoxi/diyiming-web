---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import { getPosts, getSettings } from "../lib/sanity";

const [settings, posts] = await Promise.all([getSettings(), getPosts(3)]);
const heroTitle = !settings.heroTitle || settings.heroTitle.includes("Convertimos inversión")
  ? "Transformamos tus impuestos en obras que generan desarrollo."
  : settings.heroTitle;
const heroDescription = !settings.heroDescription || settings.heroDescription.startsWith("Acompañamos a empresas privadas")
  ? "Te brindamos asesoría estratégica para estructurar, gestionar y ejecutar proyectos para impulsar el desarrollo del país mediante soluciones integrales en Obras por Impuestos (OxI)."
  : settings.heroDescription;

const capabilities = [
  { number: "01", title: "Gestión OxI", summary: "Asesoramiento y acompañamiento integral en la gestión de proyectos bajo el mecanismo de Obras por Impuestos, facilitando su planificación, ejecución y seguimiento.", href: "/gestion-oxi" },
  { number: "02", title: "Comercialización de Certificados de Inversión Pública (CIPRL)", summary: "Conectamos a nuestros clientes con empresas adquirentes de certificados para comercializar sus CIPRL y/o CIPGN de forma ágil, segura y rentable.", href: "/comercializacion-ciprl" },
  { number: "03", title: "Capacitación en el mecanismo de Obras por Impuestos", summary: "Desarrollamos capacitaciones para empresas públicas y privadas, orientadas a fortalecer sus conocimientos y capacidades para aplicar el mecanismo.", href: "/capacitacion-especializada" },
  { number: "04", title: "Desarrollo de perfiles, fichas y expedientes técnicos", summary: "Elaboramos documentos técnicos para la formulación, evaluación y ejecución de proyectos de inversión pública.", href: "/contacto?motivo=perfil-ficha-tecnica" }
];

const partners = [
  ["Gobierno Regional de La Libertad", "gobierno-regional-la-libertad.png"],
  ["Gobierno Regional de Arequipa", "gobierno-regional-arequipa.png"],
  ["Gobierno Regional de Cajamarca", "gobierno-regional-cajamarca.png"],
  ["Gobierno Regional de Ucayali", "gobierno-regional-ucayali.png"],
  ["Gobierno Regional de San Martín", "gobierno-regional-san-martin.png"],
  ["Gobierno Regional de Ica", "gobierno-regional-ica.png"],
  ["Gobierno Regional de Lambayeque", "gobierno-regional-lambayeque.png"],
  ["Municipalidad Provincial de Huancayo", "municipalidad-provincial-huancayo.png"],
  ["Municipalidad Distrital de La Tinguiña", "municipalidad-distrital-la-tinguina.png"],
  ["Municipalidad Distrital de Parcona", "municipalidad-distrital-parcona.png"],
  ["Municipalidad Distrital de Cerro Colorado", "municipalidad-distrital-cerro-colorado.png"],
  ["Municipalidad Distrital de Ocucaje", "municipalidad-distrital-ocucaje.png"],
  ["Municipalidad Distrital de San Juan Bautista", "municipalidad-distrital-san-juan-bautista.png"],
  ["Municipalidad Distrital de El Tambo", "municipalidad-distrital-el-tambo.png"]
];
---

<BaseLayout title="Diyiming Consultores | Especialistas en Obras por Impuestos" description="Gestión integral, comercialización de CIPRL, capacitación y documentos técnicos para proyectos de Obras por Impuestos en Perú.">
  <section class="hero">
    <div class="container">
      <div class="hero-copy reveal">
        <span class="eyebrow">{settings.heroEyebrow || "Consultoría especializada en OxI"}</span>
        <h1>{heroTitle}</h1>
        <p>{heroDescription}</p>
        <div class="actions">
          <a class="btn btn-primary" href="/contacto">Solicitar asesoría</a>
          <a class="btn btn-secondary" href="/obras-por-impuestos">Conocer el mecanismo</a>
        </div>
        <div class="hero-note">
          <div><strong>Visión estratégica</strong><span>Decisiones con propósito público</span></div>
          <div><strong>Rigor técnico</strong><span>Gestión responsable de cada etapa</span></div>
          <div><strong>Articulación</strong><span>Sector público y empresa privada</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="service-gateway" aria-labelledby="servicios-principales">
    <div class="container">
      <h2 id="servicios-principales" class="sr-only">Servicios principales</h2>
      <div class="service-gateway-grid reveal">
        {capabilities.map(item => (
          <a class="service-gateway-card" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.title}. Abrir información en una nueva pestaña`}>
            <span>{item.number}</span><h3>{item.title}</h3><p>{item.summary}</p><b>Conocer más ↗</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">¿Qué hacemos?</span>
      <h2>Convertimos oportunidades en proyectos de alto impacto.</h2>
      <p class="lead">Orientamos a empresas privadas y entidades públicas en el mecanismo de Obras por Impuestos para ejecutar proyectos exitosos que generen desarrollo y ayuden en el cierre de brechas. Ofrecemos un acompañamiento integral durante todo el ciclo del proyecto, asegurando una gestión eficiente, transparente y alineada con la normativa vigente.</p>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <span class="eyebrow">Metodología</span><h2>Nuestro proceso de trabajo en OxI.</h2>
      <div class="route-grid four">
        <article class="route-card reveal"><b>01</b><h3>Estructuración y viabilidad del proyecto</h3><p>Identificamos proyectos normativamente viables que se ajusten a las metas de inversión de la empresa financista.</p></article>
        <article class="route-card reveal"><b>02</b><h3>Formalización y adjudicación del proyecto</h3><p>Brindamos acompañamiento integral en el proceso de selección, resguardando la responsabilidad legal de la empresa privada frente a la entidad pública.</p></article>
        <article class="route-card reveal"><b>03</b><h3>Gestión de obra y control de calidad</h3><p>Supervisamos de manera técnica y financiera la ejecución del proyecto para prevenir retrasos en la obra y contingencias.</p></article>
        <article class="route-card reveal"><b>04</b><h3>Obtención y optimización del beneficio fiscal</h3><p>Gestionamos la recepción y liquidación de la obra hasta lograr la emisión efectiva del CIPRL o CIPGN, con seguridad jurídica para la empresa financista.</p></article>
      </div>
    </div>
  </section>

  <section class="section oxi-band">
    <div class="container oxi-grid">
      <div class="reveal">
        <span class="eyebrow">Comercialización de CIPRL</span>
        <h2>Convertimos certificados en una alternativa empresarial segura y ordenada.</h2>
        <p class="lead">Diyiming facilita la conexión entre titulares de certificados y empresas contribuyentes interesadas en adquirirlos, acompañando la evaluación, negociación, transferencia y cierre conforme al marco vigente.</p>
        <a class="btn btn-light" href="/comercializacion-ciprl">Conocer el servicio</a>
      </div>
      <div class="oxi-points reveal">
        <div class="oxi-point"><b>Evaluación documental</b><span>Revisamos la información necesaria para estructurar una operación clara y sustentada.</span></div>
        <div class="oxi-point"><b>Conexión empresarial</b><span>Articulamos oportunidades con organizaciones interesadas en el uso tributario del certificado.</span></div>
        <div class="oxi-point"><b>Acompañamiento especializado</b><span>Coordinamos cada etapa hasta completar la transferencia de forma responsable.</span></div>
      </div>
    </div>
  </section>

  <section class="section partners-section">
    <div class="container">
      <span class="eyebrow">Experiencia territorial</span>
      <div class="section-heading-row"><div><h2>Aliados y entidades donde hemos desarrollado Obras por Impuestos.</h2><p class="lead">Experiencia articulando proyectos con gobiernos regionales y municipalidades en distintas zonas del país.</p></div><a class="btn btn-outline" href="/experiencia">Conocer nuestra experiencia</a></div>
      <div class="partner-grid reveal">
        {partners.map(([name, file]) => <div class="partner-logo" title={name}><img src={`/assets/images/aliados/${file}`} alt={`Logotipo de ${name}`} loading="lazy" /><span>{name}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Conocimiento</span><h2>Información para tomar mejores decisiones.</h2>
      {posts.length ? <div class="insights">{posts.map(post => <BlogCard post={post} />)}</div> : <div class="empty-state">El contenido especializado estará disponible próximamente.</div>}
    </div>
  </section>

  <section class="cta"><div class="container cta-row"><div><span class="eyebrow">Iniciemos una conversación</span><h2>¿Está evaluando desarrollar un proyecto mediante Obras por Impuestos?</h2><p>Le ayudamos a identificar oportunidades, reducir riesgos y gestionar cada etapa del proceso hasta la obtención del CIPRL.</p></div><a class="btn btn-light" href="/contacto">Solicitar una reunión</a></div></section>
</BaseLayout>
