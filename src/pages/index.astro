---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import BlogCard from "../components/BlogCard.astro";
import { getPosts, getServices, getSettings, type Service } from "../lib/sanity";

const [settings, cmsServices, posts] = await Promise.all([
  getSettings(),
  getServices(),
  getPosts(3)
]);

const fallbackServices: Service[] = [
  { title: "Identificación y priorización", category: "Estrategia", summary: "Evaluamos oportunidades y alineamos proyectos con objetivos institucionales, territoriales y de inversión." },
  { title: "Asistencia técnica", category: "Estructuración", summary: "Ordenamos información, requisitos y decisiones necesarias para consolidar una ruta viable de proyecto." },
  { title: "Acompañamiento OxI", category: "Gestión", summary: "Facilitamos la coordinación y el seguimiento durante las etapas clave del mecanismo." },
  { title: "Coordinación institucional", category: "Articulación", summary: "Conectamos equipos y actores para sostener acuerdos, entregables y decisiones oportunas." },
  { title: "Seguimiento de hitos", category: "Control", summary: "Monitoreamos avances y alertas para fortalecer el control de compromisos y plazos." },
  { title: "Capacitación especializada", category: "Conocimiento", summary: "Desarrollamos capacidades para comprender y gestionar mejor el mecanismo OxI." }
];
const services = cmsServices.length ? cmsServices.slice(0, 6) : fallbackServices;
---

<BaseLayout
  title="Diyiming Consultores | Especialistas en Obras por Impuestos"
  description="Asesoría integral para empresas privadas y entidades públicas en proyectos ejecutados mediante Obras por Impuestos en Perú."
>
  <section class="hero">
    <div class="container">
      <div class="hero-copy reveal">
        <span class="eyebrow">{settings.heroEyebrow || "Consultoría especializada en OxI"}</span>
        <h1>{settings.heroTitle || "Convertimos inversión en infraestructura que genera desarrollo."}</h1>
        <p>{settings.heroDescription || "Acompañamos a empresas privadas y entidades públicas en la estructuración, gestión y ejecución de proyectos mediante Obras por Impuestos."}</p>
        <div class="actions">
          <a class="btn btn-primary" href="/contacto">Solicitar asesoría</a>
          <a class="btn btn-secondary" href="/obras-por-impuestos">Conocer el mecanismo</a>
        </div>
        <div class="hero-note">
          <div><strong>Visión estratégica</strong><span>Decisiones con propósito público</span></div>
          <div><strong>Rigor técnico</strong><span>Gestión responsable de cada etapa</span></div>
          <div><strong>Articulación</strong><span>Sector público y empresa privada</span></div>
        </div>
      </div>
    </div>
  </section>

  <div class="trustbar">
    <div class="container trustgrid reveal">
      <div class="trustitem"><b>Especialización OxI</b><span>Conocimiento del mecanismo y sus actores</span></div>
      <div class="trustitem"><b>Gestión integral</b><span>De la oportunidad a la ejecución</span></div>
      <div class="trustitem"><b>Enfoque técnico</b><span>Análisis para decisiones informadas</span></div>
      <div class="trustitem"><b>Impacto sostenible</b><span>Infraestructura que mejora territorios</span></div>
    </div>
  </div>

  <section class="section">
    <div class="container split">
      <div class="visual-panel reveal">
        <div class="visual-mark"><span>Una misma dirección</span><br /><b>OxI</b><p>Inversión privada, capacidad pública e impacto social.</p></div>
      </div>
      <div class="reveal">
        <span class="eyebrow">Quiénes somos</span>
        <h2>{settings.aboutTitle || "Un aliado estratégico para proyectos que transforman."}</h2>
        <p class="lead">{settings.aboutText || "Diyiming Consultores brinda orientación y apoyo técnico a empresas privadas y entidades públicas que participan en proyectos bajo el mecanismo de Obras por Impuestos."}</p>
        <p>Integramos análisis, planificación, coordinación y seguimiento para reducir la complejidad, anticipar riesgos y mantener cada iniciativa orientada a resultados.</p>
        <div class="checklist">
          <span>Lectura integral del proyecto</span><span>Coordinación entre actores</span>
          <span>Rigurosidad documental</span><span>Acompañamiento cercano</span>
        </div>
        <a class="btn btn-outline" href="/nosotros">Conocer Diyiming</a>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <span class="eyebrow">Qué hacemos</span>
      <h2>Capacidades para avanzar con claridad.</h2>
      <p class="lead">Servicios articulados para abordar los desafíos técnicos, administrativos y estratégicos de una iniciativa OxI.</p>
      <div class="cards">{services.map((service, index) => <ServiceCard service={service} index={index} compact />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Nuestra forma de trabajo</span>
      <h2>Del diagnóstico a una ruta accionable.</h2>
      <div class="process reveal">
        <div class="step"><b>01. Escuchar</b><span>Entendemos el contexto, los objetivos y las restricciones.</span></div>
        <div class="step"><b>02. Analizar</b><span>Revisamos viabilidad, actores, información y riesgos.</span></div>
        <div class="step"><b>03. Estructurar</b><span>Construimos una hoja de ruta clara y priorizada.</span></div>
        <div class="step"><b>04. Articular</b><span>Acompañamos la coordinación y toma de decisiones.</span></div>
        <div class="step"><b>05. Impulsar</b><span>Damos seguimiento hasta convertir planes en avances.</span></div>
      </div>
    </div>
  </section>

  <section class="section oxi-band">
    <div class="container oxi-grid">
      <div class="reveal">
        <span class="eyebrow">Obras por Impuestos</span>
        <h2>Una herramienta que une inversión, capacidad y propósito.</h2>
        <p class="lead">El mecanismo permite que empresas privadas financien y ejecuten proyectos públicos, recibiendo certificados aplicables al pago de impuestos conforme al marco vigente.</p>
        <a class="btn btn-light" href="/obras-por-impuestos">Entender cómo funciona</a>
      </div>
      <div class="oxi-points reveal">
        <div class="oxi-point"><b>Para empresas privadas</b><span>Canaliza inversión con impacto territorial y reputacional.</span></div>
        <div class="oxi-point"><b>Para entidades públicas</b><span>Contribuye a acelerar infraestructura prioritaria.</span></div>
        <div class="oxi-point"><b>Para la ciudadanía</b><span>Acerca servicios y obras que mejoran la calidad de vida.</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Conocimiento</span>
      <h2>Ideas para tomar mejores decisiones.</h2>
      {posts.length ? (
        <div class="insights">{posts.map(post => <BlogCard post={post} />)}</div>
      ) : (
        <div class="empty-state">El contenido especializado estará disponible próximamente.</div>
      )}
    </div>
  </section>

  <section class="cta">
    <div class="container cta-row">
      <div><span class="eyebrow">Iniciemos una conversación</span><h2>¿Tiene un proyecto, una oportunidad o una decisión por evaluar?</h2></div>
      <a class="btn btn-light" href="/contacto">Hablar con un especialista</a>
    </div>
  </section>
</BaseLayout>
