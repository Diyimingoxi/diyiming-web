---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGalleryImages, imageUrl } from "../lib/sanity";
const gallery = await getGalleryImages();
const milestones = [
  ["01", "Evaluación inicial", "Estudio del estado del proyecto y elaboración de la carta de expresión de interés."],
  ["02", "Priorización", "Seguimiento para la priorización del proyecto y la disponibilidad de recursos."],
  ["03", "Control previo", "Monitoreo para el otorgamiento del informe de control previo."],
  ["04", "Bases integradas", "Seguimiento para la elaboración y aprobación de las bases integradas."],
  ["05", "Buena pro", "Monitoreo y seguimiento hasta el otorgamiento de la buena pro."],
  ["06", "Convenio", "Asesoría para la formalización y firma del convenio de inversión."],
  ["07", "Expediente técnico", "Monitoreo para la elaboración, revisión y aprobación del expediente técnico."],
  ["08", "Primera valorización", "Asesoramiento y monitoreo para la primera valorización del proyecto."],
  ["09", "Segunda valorización", "Asesoramiento y monitoreo para la segunda valorización del proyecto."],
  ["10", "Tercera valorización", "Asesoramiento y monitoreo para la tercera valorización del proyecto."],
  ["11", "Emisión del CIPRL", "Asesoría y trazabilidad documental para la emisión del certificado."],
  ["12", "Recepción del proyecto", "Asesoría durante la recepción, liquidación y cierre del proyecto."],
];
---
<BaseLayout title="Gestión integral de Obras por Impuestos | Diyiming" description="Acompañamiento especializado durante el ciclo completo de proyectos de Obras por Impuestos.">
  <section class="page-hero service-hero"><div class="container"><div class="breadcrumbs"><a href="/">Inicio</a> / Gestión OxI</div><span class="eyebrow">Gestión integral OxI</span><h1>Del proyecto identificado a la inversión ejecutada y certificada.</h1><p class="lead">Articulamos las dimensiones técnicas, legales, financieras e institucionales para que empresas privadas y entidades públicas avancen con claridad durante todo el mecanismo.</p><div class="actions"><a class="btn btn-primary" href="/contacto?motivo=gestion-oxi">Evaluar una oportunidad</a><a class="btn btn-outline" href="/obras-por-impuestos">Entender el mecanismo</a></div></div></section>
  <section class="section"><div class="container content-grid"><div><span class="eyebrow">Acompañamiento especializado</span><h2>Una gestión coordinada de principio a fin.</h2><p class="lead">Diyiming acompaña la toma de decisiones, prepara la información necesaria y coordina a los actores del proyecto para reducir incertidumbre y sostener cada avance.</p><div class="service-list"><article class="service-detail"><h3>Para empresas privadas</h3><p>Identificamos oportunidades alineadas con sus objetivos, evaluamos riesgos y acompañamos la estructuración, selección, convenio, ejecución y emisión del CIPRL.</p></article><article class="service-detail"><h3>Para entidades públicas</h3><p>Apoyamos la priorización de inversiones, preparación documental, coordinación institucional y seguimiento técnico-administrativo del proyecto.</p></article></div></div><aside class="sidecard"><span class="eyebrow">Resultado</span><h3>Decisiones mejor sustentadas.</h3><p>Una hoja de ruta clara, documentación consistente, responsabilidades definidas y seguimiento permanente.</p><a class="btn btn-light" href="/contacto?motivo=gestion-oxi">Solicitar asesoría</a></aside></div></section>
  <section class="section soft"><div class="container"><span class="eyebrow">Galería de proyectos</span><div class="section-heading-row"><div><h2>Proyectos, obras y momentos que generan desarrollo.</h2><p class="lead">Una memoria visual administrada directamente por el equipo de Diyiming.</p></div></div>{gallery.length ? <div class="project-gallery">{gallery.map((photo) => <figure class="gallery-card reveal"><button class="gallery-open" type="button" aria-label={`Ampliar ${photo.title}`}><img src={imageUrl(photo.imageUrl, 1000)} alt={photo.imageAlt || photo.title} loading="lazy" /></button><figcaption><strong>{photo.title}</strong>{photo.caption && <span>{photo.caption}</span>}</figcaption></figure>)}</div> : <div class="gallery-empty"><strong>La galería está lista para recibir fotografías.</strong><span>El equipo puede añadir, ordenar u ocultar imágenes desde Sanity Studio.</span></div>}<dialog class="gallery-modal"><button class="gallery-close" type="button" aria-label="Cerrar">×</button><img src="" alt="" /><p></p></dialog></div></section>
  <section class="section"><div class="container"><span class="eyebrow">Acompañamiento por hitos</span><h2>Seguimiento especializado en los momentos decisivos.</h2><p class="lead">Nuestra intervención se adapta al estado de cada proyecto y mantiene continuidad técnica, documental e institucional hasta su cierre.</p><div class="route-grid">{milestones.map(([number,title,description]) => <article class="route-card"><b>{number}</b><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="cta"><div class="container cta-row"><div><span class="eyebrow">Gestión OxI</span><h2>Convierta una oportunidad en una ruta de ejecución clara.</h2><p>Cuéntenos el contexto del proyecto y evaluaremos el siguiente paso.</p></div><a class="btn btn-light" href="/contacto?motivo=gestion-oxi">Conversemos</a></div></section>
</BaseLayout>
<script>
  const modal = document.querySelector<HTMLDialogElement>('.gallery-modal');
  const modalImage = modal?.querySelector('img');
  const modalText = modal?.querySelector('p');
  document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach((button) => button.addEventListener('click', () => {
    const image = button.querySelector('img'); const caption = button.closest('figure')?.querySelector('strong')?.textContent || '';
    if (!modal || !modalImage || !image) return;
    modalImage.src = image.src; modalImage.alt = image.alt; if (modalText) modalText.textContent = caption; modal.showModal();
  }));
  modal?.querySelector('.gallery-close')?.addEventListener('click', () => modal.close());
  modal?.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
</script>
