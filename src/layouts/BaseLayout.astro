---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSettings } from "../lib/sanity";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  canonical?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/og.png",
  type = "website",
  canonical,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  structuredData = []
} = Astro.props;
const settings = await getSettings();
const canonicalUrl = new URL(canonical || Astro.url.pathname, Astro.site || Astro.url.origin);
const imageUrl = new URL(image, Astro.site || Astro.url.origin);
const siteUrl = new URL("/", Astro.site || Astro.url.origin).href;
const logoUrl = new URL("/assets/images/logo-diyiming.png", Astro.site || Astro.url.origin).href;
const socialProfiles = [settings.linkedin, settings.facebook].filter(Boolean);
const organizationSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  name: settings.companyName || "Diyiming Consultores",
  url: siteUrl,
  logo: { "@type": "ImageObject", url: logoUrl },
  description: "Consultora peruana especializada en gestión de Obras por Impuestos, comercialización de CIPRL, capacitación y documentos técnicos.",
  email: settings.email || undefined,
  telephone: settings.phone || undefined,
  address: settings.address ? {
    "@type": "PostalAddress",
    streetAddress: settings.address,
    addressCountry: "PE"
  } : undefined,
  sameAs: socialProfiles.length ? socialProfiles : undefined
};
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  url: siteUrl,
  name: "Diyiming Consultores",
  inLanguage: "es-PE",
  publisher: { "@id": `${siteUrl}#organization` }
};
const pageSchema = {
  "@type": "WebPage",
  "@id": `${canonicalUrl.href}#webpage`,
  url: canonicalUrl.href,
  name: title,
  description,
  inLanguage: "es-PE",
  isPartOf: { "@id": `${siteUrl}#website` },
  about: { "@id": `${siteUrl}#organization` }
};
const extraSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemaGraph = [organizationSchema, websiteSchema, pageSchema, ...extraSchemas].filter(Boolean);
const schemaJson = JSON.stringify({ "@context": "https://schema.org", "@graph": schemaGraph }).replace(/</g, "\\u003c");
const whatsappNumber = (settings.whatsapp || "").replace(/\D/g, "");
const whatsappMessage = encodeURIComponent(
  "Hola, deseo recibir información sobre la asesoría de Diyiming en Obras por Impuestos."
);
const whatsappUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`
  : "";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b3f91" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="author" content="Diyiming Consultores" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-PE" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Diyiming Consultores" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={schemaJson} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer settings={settings} />
    {whatsappUrl && (
      <a
        class="whatsapp-float"
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Conversar con Diyiming por WhatsApp"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.5L3 20.6l1.3-4.7a8.5 8.5 0 1 1 16.2-4.1Z" />
          <path d="M8.1 7.8c.2-.4.4-.4.7-.4h.5c.2 0 .3.1.4.4l.7 1.7c.1.3.1.5-.1.7l-.5.6c-.2.2-.1.4 0 .6.5.9 1.2 1.7 2.1 2.2.2.1.4.2.6 0l.7-.8c.2-.2.4-.3.7-.2l1.8.9c.3.1.4.3.4.5 0 .3-.2 1.3-.8 1.8-.5.5-1.2.7-1.9.6-1.1-.2-2.6-.7-4.1-2.1-1.2-1.1-2.2-2.5-2.5-3.6-.3-1.1 0-2.1.3-2.9Z" />
        </svg>
        <span>Escríbenos por WhatsApp</span>
      </a>
    )}
    <script>
      const observer = new IntersectionObserver(
        entries => entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        }),
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach(element => observer.observe(element));
    </script>
  </body>
</html>
