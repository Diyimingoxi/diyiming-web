---
import type {SiteSettings} from "../lib/sanity";

interface Props { settings: SiteSettings; }
const {settings} = Astro.props;
const email = "info@diyiming.pe";
const address = settings.address || "Calle Luis Medina 176, San Miguel, Ica";
const description = settings.footerDescription || "Orientación y apoyo técnico para empresas privadas y entidades públicas que participan en proyectos mediante Obras por Impuestos.";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <img class="footer-logo" src="/assets/images/logo-diyiming.png" alt="Diyiming Consultores" width="440" height="147" />
        <p>{description}</p>
      </div>
      <div>
        <h3>Empresa</h3>
        <a href="/nosotros">Nosotros</a><a href="/blog">Conocimiento</a><a href="/contacto">Contacto</a>
      </div>
      <div>
        <h3>Especialidad</h3>
        <a href="/gestion-oxi">Gestión OxI</a><a href="/comercializacion-ciprl">Comercialización de CIPRL</a><a href="/capacitacion-especializada">Capacitación especializada</a>
      </div>
      <div>
        <h3>Conversemos</h3>
        <p>{address}</p>
        <a href={`mailto:${email}`}>{email}</a>
        {settings.phone && <a href={`tel:${settings.phone.replace(/\s/g, "")}`}>{settings.phone}</a>}
        {settings.linkedin && <a href={settings.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
        <p>{settings.contactHours || "Atención previa coordinación."}</p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Diyiming Consultores. Todos los derechos reservados.</span>
      <a href="/privacidad">Política de privacidad</a>
    </div>
  </div>
</footer>
